# Groq API Configuration
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fast fallback / instant model:
# GROQ_MODEL=llama-3.1-8b-instant

# Relay Server Configuration
RELAY_HOST=127.0.0.1
RELAY_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Provider Selection (groq or standin)
PROVIDER_TYPE=standin
STANDIN_BASE_URL=http://127.0.0.1:8001

# Resiliency & Rate Limiter Configuration
PROVIDER_TIMEOUT=15.0
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0
MAX_CONCURRENT_REQUESTS=5
QUEUE_MAX_SIZE=50
REQUEST_DEADLINE=20.0

# Rate limits (calibrated to Groq Free Tier baseline)
CLIENT_RPM_LIMIT=30
CLIENT_TPM_LIMIT=12000
CLIENT_RPD_LIMIT=1000
CLIENT_TPD_LIMIT=100000

# Retrieval Configuration
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=90
TOP_K_PASSAGES=5
ENABLE_RERANKING=true

